{
  "name": "cv-parser",
  "version": "1.0.0",
  "private": true,
  "description": "Production CV parser: manual + Google Drive ingestion, OCR fallback, LLM extraction, PostgreSQL persistence, BullMQ background processing, Google Sheets export.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx workers/index.ts",
    "worker:watch": "tsx watch workers/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed-admin.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@napi-rs/canvas": "^0.1.60",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.40.0",
    "clsx": "^2.1.1",
    "file-type": "^20.4.0",
    "googleapis": "^148.0.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.487.0",
    "mammoth": "^1.9.0",
    "next": "15.5.25",
    "pino": "^9.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.34.0",
    "swr": "^2.3.3",
    "tesseract.js": "^6.0.0",
    "unpdf": "^0.12.1",
    "word-extractor": "^1.0.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/word-extractor": "^1.0.4",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
