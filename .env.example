# -----------------------------------------------------------------------------
# CV Parser - environment variables
# Copy to .env and fill in. Never commit .env.
# -----------------------------------------------------------------------------

# NOTE FOR VERCEL: the import screen pre-fills this form from THIS file, so pasting
# your own values on top produces duplicate keys and an "is invalid" error. Import
# nothing here, deploy once, then add the variables under Project -> Settings ->
# Environment Variables. See docs/VERCEL.md.

# -- App ----------------------------------------------------------------------
# Vercel sets NODE_ENV itself and rejects it as a custom variable - do not add it there.
NODE_ENV=development
# Public URL of the app (used for OAuth redirect + Drive webhooks). Must be HTTPS in production.
APP_URL=http://localhost:3000
# Secret used to sign session cookies and derive the token-encryption key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=
# Optional separate key for encrypting Google OAuth tokens at rest (base64, 32 bytes).
# Falls back to a key derived from AUTH_SECRET.
TOKEN_ENCRYPTION_KEY=
# Initial admin account (created by `npm run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Admin

# -- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql://cvparser:cvparser@localhost:5432/cvparser?schema=public
# Neon/Supabase only: the direct (non-pooled) host, used for schema migrations.
# Poolers run in transaction mode and cannot execute DDL. Leave blank for a plain
# Postgres; it then falls back to DATABASE_URL.
DIRECT_URL=

# -- Processing mode ----------------------------------------------------------
# "queue"  = a separate always-on worker (npm run worker) consumes Redis/BullMQ.
#            Best for bulk volumes. Requires REDIS_URL and a host that can run a
#            long-lived process (Railway, Render, Fly.io, a VM, Docker).
# "inline" = no worker process. Uploads record the job and /api/jobs/drain does
#            the work in short bursts, driven by the browser while a batch runs
#            and by a scheduled cron. This is what makes Vercel work.
PROCESSING_MODE=queue
# Shared secret the scheduler presents to /api/jobs/drain. Vercel sets CRON_SECRET
# automatically if you add it as an environment variable; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# How much one drain invocation may do (keep inside the platform's function limit)
DRAIN_BATCH_SIZE=2
DRAIN_TIME_BUDGET_MS=45000

# -- Queue (Redis + BullMQ) ---------------------------------------------------
# Required for PROCESSING_MODE=queue. Not needed for "inline".
REDIS_URL=redis://localhost:6379
# Worker concurrency (parallel CVs per worker process)
WORKER_CONCURRENCY=3
# Max LLM calls per minute per worker process (protects the external API)
LLM_RATE_LIMIT_PER_MINUTE=60
# Max processing attempts per CV (transient failures are retried with exponential backoff)
MAX_RETRIES=3
RETRY_BACKOFF_MS=5000

# -- Google OAuth 2.0 / Drive / Sheets ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback
# Optional default folder to pre-select after connecting
GOOGLE_DRIVE_FOLDER_ID=
# Optional: export into an existing spreadsheet (leave blank to create one per export)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Polling interval for new Drive files (minutes). Webhooks are registered additionally when APP_URL is HTTPS.
GOOGLE_DRIVE_SYNC_INTERVAL_MINUTES=5

# -- LLM ----------------------------------------------------------------------
# Provider: "openai"    = any OpenAI-compatible chat/completions endpoint (OpenAI, Azure, Groq, OpenRouter, Ollama, vLLM ...)
#           "anthropic" = Claude Messages API (schema-enforced tool output)
#
# OpenAI direct:
#   LLM_PROVIDER=openai   LLM_BASE_URL=            LLM_MODEL=gpt-4o-mini
# OpenRouter (one key, many models — measured 24/24 on the bundled CV fixtures):
#   LLM_PROVIDER=openai   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#   NOTE: OpenRouter ":free" models are blocked for accounts that require Zero Data
#   Retention (openrouter.ai/settings/privacy). Free endpoints may retain/train on
#   prompts, which for CVs means candidate personal data — keep ZDR on and use a
#   paid model unless you have accepted that trade-off.
# Local / no spend (Ollama):
#   LLM_PROVIDER=openai   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  LLM_API_KEY=ollama
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# openai: base URL without trailing path (default https://api.openai.com/v1)
# anthropic: default https://api.anthropic.com
LLM_BASE_URL=
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0
# Prompt version to use (services/llm/prompts)
LLM_PROMPT_VERSION=v1

# -- OCR ----------------------------------------------------------------------
# "tesseract" runs locally with no credential. The OCRProvider abstraction allows other providers.
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng
# Where tesseract language data is cached (downloaded once on first use)
OCR_CACHE_PATH=./.tesseract-cache
# If text extraction yields fewer characters than this, OCR is triggered
OCR_MIN_TEXT_CHARS=150
# Max pages to OCR per scanned PDF
OCR_MAX_PAGES=5

# -- Storage (manual uploads) -------------------------------------------------
# "local"       = uploads/ directory. Development only: a serverless filesystem is
#                 ephemeral, so uploads would vanish between requests.
# "s3"          = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Spaces)
# "vercel-blob" = Vercel Blob store. Attach one in the Vercel dashboard and it
#                 injects BLOB_READ_WRITE_TOKEN for you.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
LOCAL_STORAGE_PATH=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# -- Processing limits --------------------------------------------------------
MAX_FILE_SIZE_MB=15
MAX_FILES_PER_REQUEST=25
CONFIDENCE_THRESHOLD=0.75
# Max characters of CV text sent to the LLM
MAX_CV_TEXT_CHARS=20000

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=info
