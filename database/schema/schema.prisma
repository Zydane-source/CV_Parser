// CV Parser – Prisma schema (PostgreSQL)
// Migrations live in database/migrations (see package.json "prisma.schema").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries. On Neon/Supabase use the POOLED connection string: serverless
  // functions open many short-lived connections and would exhaust a direct one.
  //
  // `directUrl` is deliberately NOT declared here. Prisma treats it as mandatory
  // once present and fails validation when it resolves to empty, which breaks any
  // deployment that has no pooler. Migrations instead receive the direct host by
  // overriding DATABASE_URL for that one command — see the `db:migrate` script and
  // the Vercel buildCommand, which both fall back to DATABASE_URL when DIRECT_URL
  // is unset.
  url      = env("DATABASE_URL")
}

enum SourceType {
  MANUAL
  GOOGLE_DRIVE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  NEEDS_REVIEW
  FAILED
  SKIPPED
}

enum UserRole {
  /// Runs the platform: creates client workspaces and their first account, and
  /// is the only role that can see across workspace boundaries.
  OWNER
  /// Administers one client workspace: manages its people and settings.
  ADMIN
  /// Works inside one client workspace.
  RECRUITER
}

enum ExtractionMethod {
  PDF_TEXT
  DOCX
  DOC
  OCR_IMAGE
  OCR_PDF
  NONE
}

/// One client of the agency. Everything a client can see hangs off this row.
model Workspace {
  id        String   @id @default(cuid())
  /// Shown in the UI, e.g. "Apex Ventures".
  name      String
  /// Stable, URL-safe handle. Unique so it can identify a workspace in a link.
  slug      String   @unique
  /// Deactivating keeps the data and stops everyone in it signing in.
  isActive  Boolean  @default(true)
  /// How the client came to exist: "SIGNUP" (Create account), "OWNER" (added
  /// from the Clients page) or "SYSTEM" (the default workspace).
  createdVia String  @default("OWNER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  cvFiles          CVFile[]
  driveConnections GoogleDriveConnection[]

  @@index([isActive])
}

model User {
  id           String   @id @default(cuid())
  /// Login identifier, stored lower-cased. Usually an email, but a bare username
  /// such as "admin" is valid too: accounts are created by an administrator and
  /// there is no public sign-up, so no address verification depends on this.
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(RECRUITER)
  /// Null only for an OWNER, who belongs to the platform rather than a client.
  workspaceId  String?
  /// Deactivated accounts keep their history but cannot sign in.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace        Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploads          CVFile[]
  driveConnections GoogleDriveConnection[]
  sheetsExports    SheetsExport[]

  @@index([workspaceId])
}

model CVFile {
  id                String           @id @default(cuid())
  /// The client this CV belongs to. Candidate and ProcessingJob reach their
  /// workspace through here, so this single column is the isolation boundary.
  workspaceId       String
  sourceType        SourceType
  /// Google Drive file ID for Drive files; null for manual uploads.
  sourceFileId      String?
  fileName          String
  mimeType          String
  /// SHA-256 hex digest of the file bytes.
  fileHash          String
  fileSize          Int
  /// Object-storage key for manual uploads; null for Drive files (Drive is the source of truth).
  storagePath       String?
  driveUrl          String?
  driveCreatedTime  DateTime?
  driveModifiedTime DateTime?
  /// Which Drive connection this file was discovered through (Drive files only).
  driveConnectionId String?
  /// Denormalised latest processing status for fast dashboard/listing queries.
  status            ProcessingStatus @default(PENDING)
  /// Human-readable reason for SKIPPED / FAILED (mirrors the latest job's error).
  statusMessage     String?
  uploadedById      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy      User?                  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  driveConnection GoogleDriveConnection? @relation(fields: [driveConnectionId], references: [id], onDelete: SetNull)
  candidate       Candidate?
  jobs            ProcessingJob[]

  /// Scoped to the workspace: two clients may legitimately hold the same Drive
  /// file, and one importing it must not block the other.
  @@unique([workspaceId, sourceType, sourceFileId])
  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([fileHash])
  @@index([driveConnectionId])
  @@index([sourceType])
  @@index([status])
  @@index([createdAt])
  @@index([fileName])
}

model Candidate {
  id                  String           @id @default(cuid())
  cvFileId            String           @unique
  candidateName       String           @default("Not Found")
  phoneNumber         String           @default("Not Found")
  jobRoleAppliedFor   String           @default("Not Found")
  nameConfidence      Float            @default(0)
  phoneConfidence     Float            @default(0)
  roleConfidence      Float            @default(0)
  overallConfidence   Float            @default(0)
  isManuallyCorrected Boolean          @default(false)
  /// Field names that were manually corrected; these are never overwritten by reprocessing.
  correctedFields     String[]         @default([])
  /// Reasons the record was flagged for review (validation failures, low confidence).
  reviewReasons       String[]
  /// Machine-readable companions to reviewReasons (NO_NAME_FOUND, LOW_CONFIDENCE, ...).
  reviewCodes         String[]         @default([])
  /// How the *text* was obtained (PDF layer, DOCX, OCR). Unchanged by the migration.
  extractionMethod    ExtractionMethod @default(NONE)
  /// Retained for history. Holds the LLM model name for rows parsed before the
  /// migration, and "local-engine" for rows parsed by the deterministic engine.
  llmModel            String?
  /// Prompt version (LLM rows) or engine version (local rows).
  promptVersion       String?

  /// Which engine produced the fields: "local" or "llm". Null for pre-migration rows.
  extractionEngine  String?
  /// Semantic version of the extraction algorithms, so a result can be traced to
  /// the code that produced it and reprocessed when that code improves.
  extractionVersion String?
  /// Per-field provenance from the local engine, e.g.
  /// { "candidate_name": "explicit_label", "phone_number": "contact_section" }.
  fieldMethods      Json?
  /// Milliseconds spent in field extraction alone (excludes text extraction/OCR).
  extractionMs      Int?
  /// True when OCR supplied the text, which lowers confidence in every field.
  ocrUsed           Boolean @default(false)
  /// Denormalised review flag. `reviewReasons` holds the why; this is for indexing.
  reviewRequired    Boolean @default(false)

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cvFile CVFile @relation(fields: [cvFileId], references: [id], onDelete: Cascade)

  @@index([candidateName])
  @@index([phoneNumber])
  @@index([jobRoleAppliedFor])
  @@index([createdAt])
  @@index([processedAt])
  @@index([extractionEngine])
  @@index([reviewRequired])
}

model ProcessingJob {
  id           String           @id @default(cuid())
  cvFileId     String
  /// Client-side batch identifier (one per upload session / drive sync) for live progress views.
  batchId      String?
  queueJobId   String?
  status       ProcessingStatus @default(PENDING)
  stage        String?
  attempts     Int              @default(0)
  maxAttempts  Int              @default(3)
  errorMessage String?
  errorCode    String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  cvFile CVFile @relation(fields: [cvFileId], references: [id], onDelete: Cascade)

  @@index([cvFileId])
  @@index([status])
  @@index([batchId])
  @@index([createdAt])
}

model GoogleDriveConnection {
  id                 String    @id @default(cuid())
  workspaceId        String
  userId             String
  googleAccountEmail String?
  /// AES-256-GCM encrypted OAuth tokens (see lib/crypto.ts).
  accessTokenEnc     String
  refreshTokenEnc    String?
  tokenExpiry        DateTime?
  scope              String?
  folderId           String?
  folderName         String?
  folderPath         String?
  /// Drive Changes API cursor for incremental sync.
  startPageToken     String?
  lastSyncAt         DateTime?
  lastSyncError      String?
  lastSyncFileCount  Int       @default(0)
  watchChannelId     String?
  watchResourceId    String?
  watchExpiry        DateTime?
  watchToken         String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     CVFile[]

  @@index([workspaceId])
  @@index([userId])
  @@index([isActive])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SheetsExport {
  id             String   @id @default(cuid())
  userId         String?
  spreadsheetId  String
  spreadsheetUrl String
  sheetTitle     String
  rowCount       Int
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Uploaded CV bytes, when no object store is configured.
///
/// Object storage is the better home for files and stays the recommended
/// production setup. But a deployment with no bucket and no blob token has
/// nowhere at all to put an upload — on a serverless host the filesystem is
/// read-only — and that is a configuration cliff rather than a design choice.
/// CVs are small (a few hundred KB; the platform caps request bodies at ~4 MB),
/// so the database holds them perfectly well at recruitment volumes.
///
/// Rows are private by construction: there is no URL, and reads go through the
/// authenticated download route like every other storage driver.
model StoredFile {
  /// The same opaque object key the other drivers use, so CVFile.storagePath
  /// means the same thing whichever driver wrote it.
  key       String   @id
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A pending "Create account" request.
///
/// Nothing is created in Workspace or User until the emailed code is entered, so
/// an abandoned or unapproved sign-up leaves no account behind. The code itself
/// is never stored — only an HMAC of it — and the password is hashed exactly as
/// it would be on a real account.
model SignupRequest {
  id           String    @id @default(cuid())
  name         String
  /// The login identifier the account will have, lower-cased.
  email        String
  companyName  String
  passwordHash String
  codeHash     String
  attempts     Int       @default(0)
  expiresAt    DateTime
  /// Last time a code was sent; used to throttle "resend".
  sentAt       DateTime  @default(now())
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}
