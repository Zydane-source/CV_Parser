# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/tests/fixtures/generated/
# Benchmark corpus: 120 generated CVs, reproducible with `npm run corpus`.
# The labels and the scored results are tracked; the binaries are not.
/tests/fixtures/benchmark/*
!/tests/fixtures/benchmark/ground-truth.json
!/tests/fixtures/benchmark/results-*.json

# next.js
/.next/
/out/

# production builds
/build
/dist

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env / secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
client_secret*.json

# uploaded CVs (personal data) - never commit
/uploads/*
!/uploads/.gitkeep
/tmp/
/.tesseract-cache/

# local databases
*.sqlite
*.db

# misc
.DS_Store
Thumbs.db
*.tsbuildinfo
next-env.d.ts
/.vscode/
/.idea/

# verification build output
/.next-build/
